# Copy to android/keystore.properties and fill in. That file is gitignored —
# a leaked release keystore cannot be rotated, and anyone holding it can ship
# updates as you.
#
# Create a keystore with:
#   keytool -genkey -v -keystore talkie-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias talkie
#
# storeFile is resolved relative to android/app/.
storeFile=../../talkie-release.jks
storePassword=
keyAlias=talkie
keyPassword=
